{
  "widget_id": "yield-curve",
  "sort_seq": 70,
  "name": "Treasury Yields",
  "description": "Yield curve snapshot · maturity trends (compare up to 4)",
  "group_name": "Macro",
  "view_type": "lines",
  "endpoint": "/data/{provider}/yield_curve?date={date}",
  "source": "$provider",
  "transform": "yield_points",
  "empty_text": "수익률 데이터가 없어요",
  "size": {"w": 7, "h": 6, "min_w": 4, "min_h": 4},
  "params": [
    {"param_name": "date", "label": "기준일"},
    {
      "param_name": "period",
      "label": "기간",
      "param_value": "3mo",
      "options": [
        {"option_value": "1mo", "label": "1M"},
        {"option_value": "3mo", "label": "3M"},
        {"option_value": "1y", "label": "1Y"},
        {"option_value": "5y", "label": "5Y"}
      ]
    }
  ],
  "tabs": [
    {"tab_code": "curve", "label": "국채 수익률 곡선"},
    {"tab_code": "trend", "label": "추이"}
  ],
  "options": {
    "labels": "true",
    "provider": "fred",
    "series": "value:수익률",
    "tab.curve.controls": "date",
    "tab.trend.controls": "period",
    "tab.trend.endpoint": "/data/{provider}/yield_curve_history?period={period}",
    "tab.trend.labels": "false",
    "tab.trend.pick": "y2,y10",
    "tab.trend.series": "m3:3M,m6:6M,y1:1Y,y2:2Y,y5:5Y,y10:10Y,y30:30Y",
    "tab.trend.x": "date",
    "unit": "%",
    "x": "_label"
  },
  "screens": [
    {"screen": "*"},
    {"screen": "/macro", "tab": "overview", "x": 0, "y": 1, "w": 7, "h": 6}
  ]
}
